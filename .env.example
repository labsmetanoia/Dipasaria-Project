# Copy to .env.local. Leave the Supabase values empty to run in demo mode (in-memory data, resets on restart).

# Public site URL (used for links in WhatsApp messages and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API). The service-role key is server-only and never sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode (in-memory data). Development allows it automatically. A production build refuses to start
# without Supabase unless DEMO_MODE=1, so a missing key cannot silently turn the live shop into a demo.
# DEMO_MODE=1

# Demo-mode admin password. Required when DEMO_MODE=1 in production; "dipasaria" is accepted only in development.
DEMO_ADMIN_PASSWORD=dipasaria

# Secret used to sign session cookies: at least 16 characters, generate with `openssl rand -hex 32`.
# Production refuses to start with this example value.
SESSION_SECRET=change-me-to-a-long-random-string

# Secret for the scheduled standing-order job (Vercel Cron sends it as "Authorization: Bearer <secret>")
CRON_SECRET=change-me-to-another-long-random-string

# Bot protection (optional, free): Cloudflare Turnstile on checkout, business login and account applications.
# Create a widget at dash.cloudflare.com → Turnstile, add your domain, copy both keys. Leave empty to rely on rate limits only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Error alerts (optional): new errors are posted here as JSON {"text": ...}. Works with a Telegram bot
# (https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>), a Slack incoming webhook or a Discord webhook.
ALERT_WEBHOOK_URL=

# QRIS with automatic confirmation (Midtrans Core API). Dashboard → Settings → Access Keys → Server Key.
# Sandbox keys start with "SB-" and use the sandbox API automatically. Leave empty for the manual QRIS image flow.
# In the Midtrans dashboard set Payment Notification URL to https://<your-domain>/api/payments/midtrans
MIDTRANS_SERVER_KEY=
# Optional: MIDTRANS_ENV=production|sandbox (overrides the key prefix), MIDTRANS_QRIS_ACQUIRER=gopay (default) or shopeepay

# Automatic WhatsApp messages to customers (Meta WhatsApp Cloud API). Without these, messages are prepared in
# Back-office → Pesan WA and sent by hand with one tap. Templates to create: docs/whatsapp-templates.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: WHATSAPP_API_VERSION=v26.0, WHATSAPP_TEMPLATE_LANG=id
# Household sign-in codes use the Authentication template WHATSAPP_OTP_TEMPLATE (default dipasaria_kode_masuk);
# WHATSAPP_OTP_BUTTON_SUBTYPE (default url) is the copy-code button's sub_type in the send request.

# Only when NOT hosting on Vercel: the header your proxy sets with the visitor's IP (e.g. cf-connecting-ip for Cloudflare).
# Rate limits use it; never point it at a header visitors can send themselves.
# CLIENT_IP_HEADER=
