# Copy to .env.local. Leave the Supabase values empty to run in demo mode (in-memory data, resets on restart).

# Public site URL (used for links in WhatsApp messages and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API). The service-role key is server-only and never sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo-mode admin password (only used when Supabase is not configured)
DEMO_ADMIN_PASSWORD=dipasaria

# Secret used to sign the business-account session cookie (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Secret for the scheduled standing-order job (Vercel Cron sends it as "Authorization: Bearer <secret>")
CRON_SECRET=change-me-to-another-long-random-string
